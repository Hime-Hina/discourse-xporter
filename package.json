{
  "name": "discourse-xporter",
  "version": "1.0.0",
  "description": "Export Discourse topics to Obsidian Markdown",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src test vite.config.ts vitest.config.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
