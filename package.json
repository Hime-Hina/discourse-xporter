    "vitest": "^3.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "engines": {
    "node": "24.x"
  },
